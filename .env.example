# Navegador (publicáveis — gerados automaticamente pelo Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Servidor (segredos — NUNCA expor no navegador)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de IA (padrão: Lovable AI Gateway, já gerenciado)
LOVABLE_API_KEY=
# Opcional: provedor compatível com a API Chat Completions da OpenAI
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER_NAME=

# n8n (opcional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Notificação externa opcional (recebe eventos de análise concluída)
NOTIFY_WEBHOOK_URL=
